{
  "name": "@rateships/customs",
  "version": "0.1.0",
  "description": "International customs duty + VAT data for 213 countries with built-in landed cost calculator",
  "keywords": [
    "customs",
    "duty",
    "vat",
    "import",
    "shipping",
    "international",
    "ecommerce",
    "de-minimis",
    "landed-cost",
    "tariff"
  ],
  "homepage": "https://rateships.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rateships/customs.git"
  },
  "bugs": {
    "url": "https://github.com/rateships/customs/issues"
  },
  "license": "MIT",
  "author": "RateShips <kd@globalpost.ua> (https://rateships.com)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./data": "./data/customs.json"
  },
  "bin": {
    "rateships-customs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts",
    "test": "vitest run",
    "lint": "eslint src",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
